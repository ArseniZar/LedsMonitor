// NOTE:
// 1. Create a file ConfigDefault.cpp in the config folder.
// 2. Copy everything from this example file into ConfigDefault.cpp.
// 3. Update the fields below (Wi‑Fi credentials, LED count, Telegram token, etc.)
//    according to your setup.
// 4. Rebuild and flash the firmware.

#include "ConfigDefault.h"

// Basic network configuration (example):
// ssid / password     - no saved default Wi‑Fi network (empty strings)
// "SmartHome"        - SSID of the access point started in portal mode
// "12345678"         - access point password (minimum 8 characters)
// "smarthome"        - mDNS name: the device will be available as smarthome.local
const NetworkConfig& DEFAULT_NETWORK_CONFIG = NetworkConfig::defaultConfig(
	"",          // ssid (not saved by default)
	"",          // password
	"SmartHome", // AP SSID
	"12345678",  // AP password
	"smarthome", // mDNS name
	10000UL       // Wi-Fi connection timeout (ms)
);


// Basic LED device configuration for "out of the box" firmware (example).
// 3  - hardware data pin (see DEVICE_PIN in config.h)
// 40 - default number of LEDs in the strip
// "Led" - device name shown in UI / Telegram
const DeviceLedConfig& DEFAULT_DEVICE_CONFIG = DeviceLedConfig::defaultConfig(
	3,
	40,
	"Led"
);


// Basic Telegram bot configuration (example):
// token         - empty by default until the user sets their token
// limitMessage  - maximum number of messages per tick (anti‑spam)
// periodUpdate  - Telegram polling period (ms)
const TelegramBotConfig& DEFAULT_TELEGRAM_CONFIG = TelegramBotConfig::defaultConfig(
	"",   // token
	10,    // limitMessage
	1000   // periodUpdate
);

